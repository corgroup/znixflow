{
  "name": "znixflow-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "tsc -p tsconfig.json && pnpm --filter @znixflow/admin-web build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run tests/infrastructure.integration.test.ts",
    "test:security": "vitest run tests/security.test.ts",
    "db:migrate": "tsx scripts/migrate.ts up",
    "db:rollback": "tsx scripts/migrate.ts down",
    "db:status": "tsx scripts/migrate.ts status"
  },
  "dependencies": {
    "fastify": "^5.6.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "zod": "^4.1.0",
    "mysql2": "^3.14.0",
    "ioredis": "^5.7.0",
    "bullmq": "^5.58.0",
    "pino": "^9.9.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "typescript-eslint": "^8.40.0",
    "prettier": "^3.6.0"
  }
}
